# Local dev: copy this file to secrets.toml (in this same .streamlit/ folder)
# and fill in your real key. secrets.toml is gitignored — never commit it.
#
# Streamlit Community Cloud: don't upload this file there at all — paste the
# key into the app's Settings -> Secrets dashboard instead. Streamlit reads
# both sources into st.secrets the same way, so app code doesn't change.
GROQ_API_KEY = "gsk_your_actual_key_here"
